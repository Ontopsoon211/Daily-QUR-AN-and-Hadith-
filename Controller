import { db } from "../config/firebase.js"

export async function getDailyContent(req, res) {
  try {
    const doc = await db.collection("daily").doc("today").get()

    if (!doc.exists) {
      return res.status(404).json({
        success: false,
        message: "No content found"
      })
    }

    res.json({
      success: true,
      data: doc.data()
    })
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    })
  }
}
